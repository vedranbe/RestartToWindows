// Restart To Windows - allow the GNOME extension to set the next boot entry
// without asking for a password.
//
// The polkit action that pkexec checks is always
// "org.freedesktop.policykit.exec", so the rule matches on the program that is
// about to be executed. Only the root owned helper installed by
// setup-passwordless.sh is allowed, and only for the user who is logged in at
// the machine right now.
//
// The helper can do exactly one thing: point the UEFI "BootNext" variable at
// an existing boot entry. Rebooting is left to systemd-logind, which already
// permits it for active sessions.

polkit.addRule(function (action, subject) {
    if (action.id !== 'org.freedesktop.policykit.exec')
        return undefined;

    const program = action.lookup('program');
    if (program !== '/usr/libexec/restart-to-windows' &&
        program !== '/usr/local/libexec/restart-to-windows')
        return undefined;

    if (!subject.local || !subject.active)
        return undefined;

    return polkit.Result.YES;
});
