msgid "Restart to Windows"
msgstr "Ponovo pokreni u Windows"

msgid "Restart the computer to Windows"
msgstr "Ponovo pokreni računar u Windows"

msgid "Success"
msgstr "Uspješno"

msgid "Failed"
msgstr "Neuspješno"

msgid "Error"
msgstr "Greška"

msgid "Cancel"
msgstr "Otkaži"

msgid "Restart"
msgstr "Ponovo pokreni"

msgid "The system will restart to Windows in %d seconds."
msgstr "Sistem će se ponovo pokrenuti u Windows za %d sekundi."

msgid "Restarting..."
msgstr "Ponovno pokretanje..."

msgid "Restart to Windows…"
msgstr "Ponovo pokreni u Windows…"

msgid "efibootmgr is required by this extension. Please install it and try again."
msgstr "Ova ekstenzija zahtijeva efibootmgr. Instalirajte ga i pokušajte ponovno."

msgid "Failed to restart to Windows."
msgstr "Neuspješno ponovno pokretanje u Windows."

msgid "Could not find the Windows Boot Manager entry in the UEFI boot entries. Is this a dual-boot system?"
msgstr "Stavka Windows Boot Manager nije pronađena među UEFI stavkama pokretanja. Je li ovo sistem s dualnim pokretanjem?"

msgid "Run the bundled setup-passwordless.sh script as root once to restart to Windows without being asked for a password."
msgstr "Jednom pokrenite priloženu skriptu setup-passwordless.sh kao root da bi se računalo ponovo pokrenulo u Windows bez upita za lozinku."

msgid "The pending Windows boot entry could not be cleared, so the next restart may still go to Windows."
msgstr "Zabiljena stavka pokretanja za Windows nije mogla biti obrisana, pa sljedeće ponovno pokretanje i dalje može pokrenuti Windows."

msgid "The computer will restart into Windows."
msgstr "Računalo će se ponovo pokrenuti i pokrenuti Windows."
