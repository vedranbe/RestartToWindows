msgid "Restart to Windows"
msgstr "Reiniciar para Windows"

msgid "Restart the computer to Windows"
msgstr "Reiniciar o computador para Windows"

msgid "Success"
msgstr "Sucesso"

msgid "Failed"
msgstr "Falha"

msgid "Error"
msgstr "Erro"

msgid "Cancel"
msgstr "Cancelar"

msgid "Restart"
msgstr "Reiniciar"

msgid "The system will restart to Windows in %d seconds."
msgstr "O sistema será reiniciado para o Windows em %d segundos."

msgid "Restarting..."
msgstr "Reiniciando..."

msgid "Restart to Windows…"
msgstr "Reiniciar para Windows…"

msgid "efibootmgr is required by this extension. Please install it and try again."
msgstr "Esta extensão requer o efibootmgr. Instale-o e tente novamente."

msgid "Failed to restart to Windows."
msgstr "Falha ao reiniciar para o Windows."

msgid "Could not find the Windows Boot Manager entry in the UEFI boot entries. Is this a dual-boot system?"
msgstr "Não foi encontrada a entrada Windows Boot Manager nas entradas de inicialização UEFI. Este é um sistema de inicialização dupla?"

msgid "Run the bundled setup-passwordless.sh script as root once to restart to Windows without being asked for a password."
msgstr "Execute uma vez o script setup-passwordless.sh incluído como root para reiniciar no Windows sem que a senha seja solicitada."

msgid "The pending Windows boot entry could not be cleared, so the next restart may still go to Windows."
msgstr "Não foi possível limpar a entrada de inicialização do Windows pendente, portanto a próxima reinicialização ainda pode iniciar o Windows."

msgid "The computer will restart into Windows."
msgstr "O computador será reiniciado e o Windows será iniciado."
